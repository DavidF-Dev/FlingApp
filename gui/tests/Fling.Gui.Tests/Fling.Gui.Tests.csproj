<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately sets no UI framework flag. The desktop SDK swaps the implicit using set
    for a WinForms-oriented one that drops System.IO and System.Net.Http, and the
    framework reference arrives transitively through the project reference anyway.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fling.Gui\Fling.Gui.csproj" />
  </ItemGroup>

</Project>
