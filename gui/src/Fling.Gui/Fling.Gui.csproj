<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The only project permitted to set a UI framework flag. WinForms is here solely for
    NotifyIcon, which WPF has no equivalent for; WPF drives everything else. Adding
    either flag to a project the CLI references would cost it roughly 58 MB and its
    ability to trim.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FlingTray</AssemblyName>
    <RootNamespace>Fling.Gui</RootNamespace>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WPF is not trim-compatible, so the tray app ships untrimmed. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\cli\src\Fling.Core\Fling.Core.csproj" />
    <ProjectReference Include="..\..\..\cli\src\Fling.Windows\Fling.Windows.csproj" />
  </ItemGroup>

</Project>
