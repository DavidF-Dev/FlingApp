<Window x:Class="Fling.Gui.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" Height="600" MinWidth="440" MinHeight="480">

    <Window.Resources>
        <Style x:Key="GroupHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="GroupNote" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Error banner -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}" Foreground="#C0392B">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Shared with the CLI -->
                <TextBlock Style="{StaticResource GroupHeading}" Text="Fling settings" />
                <TextBlock Style="{StaticResource GroupNote}"
                           Text="Shared with the fling command line tool." />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Maximum size" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="MaxSizeBox" Padding="4,3"
                             VerticalContentAlignment="Center"
                             Text="{Binding MaxSizeMb, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" />
                </Grid>

                <CheckBox Content="Compress text before sending" IsChecked="{Binding Compress}" />

                <TextBlock Text="This PC's name" Margin="0,4,0,4" />
                <TextBox x:Name="HostNameBox" Padding="4,3" Margin="0,0,0,4"
                         Text="{Binding HostName, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Style="{StaticResource GroupNote}">
                    <Run Text="Shown on your devices. Leave empty to use" />
                    <Run Text="{Binding HostNamePlaceholder, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
                </TextBlock>

                <CheckBox Content="Write a log file" IsChecked="{Binding Log}" />
                <TextBlock Style="{StaticResource GroupNote}"
                           Text="Records each send and its outcome. Useful when a send from Greenshot or Explorer fails silently." />

                <Separator Margin="0,6,0,14" />

                <!-- Tray app only -->
                <TextBlock Style="{StaticResource GroupHeading}" Text="App preferences" />
                <TextBlock Style="{StaticResource GroupNote}"
                           Text="These affect the tray app only." />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Notify me" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" x:Name="NotificationPicker" HorizontalAlignment="Left"
                              MinWidth="160" VerticalContentAlignment="Center"
                              SelectedValuePath="Tag" SelectedValue="{Binding Notifications}">
                        <ComboBoxItem Content="Always" Tag="Always" />
                        <ComboBoxItem Content="Only when a send fails" Tag="FailuresOnly" />
                        <ComboBoxItem Content="Never" Tag="Never" />
                    </ComboBox>
                </Grid>

                <CheckBox Content="Remember the last device I sent to" IsChecked="{Binding RememberLastDevice}" />
                <CheckBox Content="Start Fling when I sign in" IsChecked="{Binding RunAtStartup}" />
                <CheckBox Content="Add Fling to Explorer's Send to menu" IsChecked="{Binding SendToInstalled}" />
                <TextBlock Style="{StaticResource GroupNote}"
                           Text="Right-click a file in Explorer and choose Send to &gt; Fling." />

                <Separator Margin="0,6,0,14" />

                <!-- About -->
                <TextBlock Style="{StaticResource GroupHeading}" Text="About" />
                <TextBlock Style="{StaticResource GroupNote}">
                    <Run Text="Fling tray app version" />
                    <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Open config folder" Padding="12,4" Click="OnOpenConfigFolderClicked" />
                    <Button Content="Open log file" Padding="12,4" Margin="8,0,0,0"
                            IsEnabled="{Binding CanOpenLog}" Click="OnOpenLogClicked" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
